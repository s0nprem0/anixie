{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "anixie_bg": "@BG@",
    "anixie_bg_dark": "@BG_DARK@",
    "anixie_bg_light": "@BG_LIGHT@",
    "anixie_fg": "@FG@",
    "anixie_fg_light": "@FG_LIGHT@",
    "anixie_accent": "@ACCENT@",
    "anixie_secondary": "@SECONDARY@",
    "anixie_tertiary": "@TERTIARY@",
    "anixie_error": "@DANGER@"
  },
  "theme": {
    "primary":              { "dark": "anixie_accent",     "light": "anixie_accent" },
    "secondary":            { "dark": "anixie_secondary",   "light": "anixie_secondary" },
    "accent":               { "dark": "anixie_tertiary",    "light": "anixie_tertiary" },
    "error":                { "dark": "anixie_error",       "light": "anixie_error" },
    "warning":              { "dark": "anixie_tertiary",    "light": "anixie_tertiary" },
    "success":              { "dark": "anixie_accent",      "light": "anixie_accent" },
    "info":                 { "dark": "anixie_secondary",   "light": "anixie_secondary" },
    "text":                 { "dark": "anixie_fg",          "light": "anixie_fg" },
    "textMuted":            { "dark": "anixie_fg_light",    "light": "anixie_fg_light" },
    "background":           { "dark": "anixie_bg",          "light": "anixie_bg" },
    "backgroundPanel":      { "dark": "anixie_bg_dark",     "light": "anixie_bg_dark" },
    "backgroundElement":    { "dark": "anixie_bg_dark",     "light": "anixie_bg_dark" },
    "border":               { "dark": "anixie_bg_light",   "light": "anixie_bg_light" },
    "borderActive":         { "dark": "anixie_accent",      "light": "anixie_accent" },
    "borderSubtle":         { "dark": "anixie_bg_light",    "light": "anixie_bg_light" },
    "diffAdded":            { "dark": "anixie_accent",      "light": "anixie_accent" },
    "diffRemoved":          { "dark": "anixie_error",       "light": "anixie_error" },
    "diffContext":          { "dark": "anixie_fg_light",    "light": "anixie_fg_light" },
    "diffHunkHeader":       { "dark": "anixie_tertiary",    "light": "anixie_tertiary" },
    "diffHighlightAdded":   { "dark": "anixie_accent",      "light": "anixie_accent" },
    "diffHighlightRemoved": { "dark": "anixie_error",       "light": "anixie_error" },
    "diffAddedBg":          { "dark": "anixie_bg_dark",     "light": "anixie_bg_dark" },
    "diffRemovedBg":        { "dark": "anixie_bg_dark",     "light": "anixie_bg_dark" },
    "diffContextBg":        { "dark": "anixie_bg",          "light": "anixie_bg" },
    "diffLineNumber":       { "dark": "anixie_bg_light",    "light": "anixie_bg_light" },
    "diffAddedLineNumberBg":    { "dark": "anixie_bg_dark", "light": "anixie_bg_dark" },
    "diffRemovedLineNumberBg":  { "dark": "anixie_bg_dark", "light": "anixie_bg_dark" },
    "markdownText":         { "dark": "anixie_fg",          "light": "anixie_fg" },
    "markdownHeading":      { "dark": "anixie_accent",      "light": "anixie_accent" },
    "markdownLink":         { "dark": "anixie_secondary",   "light": "anixie_secondary" },
    "markdownLinkText":     { "dark": "anixie_tertiary",    "light": "anixie_tertiary" },
    "markdownCode":         { "dark": "anixie_tertiary",    "light": "anixie_tertiary" },
    "markdownBlockQuote":   { "dark": "anixie_fg_light",    "light": "anixie_fg_light" },
    "markdownEmph":         { "dark": "anixie_tertiary",    "light": "anixie_tertiary" },
    "markdownStrong":       { "dark": "anixie_accent",      "light": "anixie_accent" },
    "markdownHorizontalRule": { "dark": "anixie_bg_light",  "light": "anixie_bg_light" },
    "markdownListItem":     { "dark": "anixie_accent",      "light": "anixie_accent" },
    "markdownListEnumeration": { "dark": "anixie_tertiary", "light": "anixie_tertiary" },
    "markdownImage":        { "dark": "anixie_secondary",   "light": "anixie_secondary" },
    "markdownImageText":    { "dark": "anixie_tertiary",    "light": "anixie_tertiary" },
    "markdownCodeBlock":    { "dark": "anixie_fg",          "light": "anixie_fg" },
    "syntaxComment":        { "dark": "anixie_bg_light",    "light": "anixie_bg_light" },
    "syntaxKeyword":        { "dark": "anixie_accent",      "light": "anixie_accent" },
    "syntaxFunction":       { "dark": "anixie_accent",      "light": "anixie_accent" },
    "syntaxVariable":       { "dark": "anixie_fg",          "light": "anixie_fg" },
    "syntaxString":         { "dark": "anixie_tertiary",    "light": "anixie_tertiary" }
  }
}
