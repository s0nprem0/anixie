import QtQuick
import ".."
import "../Ui"
import Quickshell.Io

// The key, lit while sudo has passwordless rules.
//
// It is a warning about a machine, not a switch: where NOPASSWD is on, anyone
// who can reach the session can escalate, and that is the thing to remember
// when a laptop travels somewhere else. On this machine it is off — sudo asks,
// see modules/system/users.nix — so the key is not on the bar at all; it is
// here for the machine where it is the other way round, and hides itself the
// moment sudo asks for a password again.
//
// A click opens the declarative setting rather than visudo. /etc/sudoers is
// generated by the activation, so a manual edit is silently lost at the next
// rebuild; the file that actually decides it is users.nix in the checkout.
BarWidget {
  id: root

  // "off", "partial" or "full", as passwordless-sudo reports it. "partial" is a
  // NOPASSWD rule for some commands: worth a warning, because one usable command
  // can be enough, but not the same claim as full root.
  property string mode: "off"

  readonly property bool passwordless: root.mode !== "off"

  readonly property string status: {
    if (root.mode === "full") return "Sudo needs no password · click to edit"
    if (root.mode === "partial") return "Sudo has passwordless commands · click to edit"
    return "Sudo asks for a password"
  }

  // Read once, and re-read when the editor closes. Nothing here changes on a
  // timer — sudo is decided when the system is built — so a poll would be the
  // bar asking the same question every few seconds for an answer that can only
  // change by a rebuild.
  Process {
    id: probe
    command: ["passwordless-sudo"]
    running: true
    stdout: StdioCollector {
      id: collector
      onStreamFinished: {
        const mode = collector.text.trim()
        root.mode = mode === "full" || mode === "partial" ? mode : "off"
      }
    }
  }

  function refresh() {
    probe.running = false
    probe.running = true
  }

  // Its own Process rather than Commands.run so the exit can be seen: after the
  // editor closes, the setting may have changed, so ask again.
  Process {
    id: editor
    command: ["passwordless-sudo", "edit"]
    onExited: root.refresh()
  }

  // Shown only while it is true, so on a machine where sudo does ask, this costs
  // the bar nothing.
  wantsSlot: root.passwordless

  implicitWidth: readout.implicitWidth
  implicitHeight: readout.implicitHeight

  BarIconButton {
    id: readout
    anchors.centerIn: parent
    text: Util.key
    labelText: ""
    tooltipText: root.status
    active: true
    // Urgent rather than accent: this one is about how much the session is worth
    // to anyone who reaches it, and it should not sit there in the same colour as
    // a chosen workspace.
    foreground: Theme.danger
    activeColor: Theme.danger
    selected: true
    onPressed: function () {
      if (!editor.running) editor.running = true
    }
  }
}