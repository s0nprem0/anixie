{
  "background": "clear",
  "layout": {
    "left": [
      { "id": "bar.menu" },
      { "id": "bar.spacer", "size": 12 },
      { "id": "bar.workspaces" }
    ],
    "centerBegin": [
      { "id": "bar.media" },
      { "id": "weather", "type": "command", "exec": "sh $HOME/.config/quickshell/scripts/weather.sh", "interval": 1800, "tooltip": "Weather" }
    ],
    "center": [
      { "id": "bar.clock" }
    ],
    "centerEnd": [
      { "id": "bar.indicators" }
    ],
    "right": [
      { "id": "bar.tray" },
      { "id": "bar.active-window", "maxWidth": 200 },
      { "id": "bar.microphone" },
      { "id": "bar.bluetooth" },
      { "id": "bar.wifi" },
      { "id": "bar.audio" },
      { "id": "bar.power" }
    ]
  }
}