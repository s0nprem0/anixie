{
  config,
  flakeDir,
  pkgs,
  ...
}:

let
  # The modes the bar's indicators show, as one command. The keys call it, the
  # indicator polls it, and the picker lists it — one answer to "is it on".
  toggle = pkgs.writeShellScriptBin "toggle" (
    builtins.replaceStrings
      [
        "@HYPRCTL@"
        "@QUICKSHELL@"
        "@ANIXIE_LIB@"
      ]
      [
        "${pkgs.hyprland}/bin/hyprctl"
        "${pkgs.quickshell}/bin/quickshell"
        "${../../cli/lib.sh}"
      ]
      (builtins.readFile ./toggle.sh)
  );

  # Whether sudo asks for a password, so the bar can say when it does not. On
  # this machine it does, since users.nix sets wheelNeedsPassword — but the
  # reading is asked of sudo itself rather than assumed from the setting, because
  # a rule can arrive from a group, a drop-in or another module, and the answer
  # wanted is the one sudo will actually give.
  #
  # `edit` opens users.nix in the checkout rather than running visudo: /etc/sudoers
  # is generated by the activation, so an edit there is lost at the next rebuild.
  passwordlessSudo = pkgs.writeShellScriptBin "passwordless-sudo" (
    builtins.replaceStrings
      [ "@SUDO@" "@TERMINAL@" "@EDITOR@" "@REPO@" "@ANIXIE_LIB@" ]
      [
        "/run/wrappers/bin/sudo"
        "${pkgs.kitty}/bin/kitty"
        "${pkgs.helix}/bin/hx"
        "${config.home.homeDirectory}/${flakeDir}"
        "${../../cli/lib.sh}"
      ]
      (builtins.readFile ./passwordless-sudo.sh)
  );

  # Who is logged in, and from somewhere else or not. logind rather than any one
  # remote tool's own idea of who is connected — no remote desktop is installed
  # here, and the bar should still say something if SSH ever is.
  remoteSession = pkgs.writeShellScriptBin "remote-session" (
    builtins.replaceStrings [ "@LOGINCTL@" ] [ "${pkgs.systemd}/bin/loginctl" ] (
      builtins.readFile ./remote-session.sh
    )
  );
in
{
  home.packages = [
    toggle
    passwordlessSudo
    remoteSession
  ];

  # The inhibitor behind `toggle stayawake`. A unit rather than a backgrounded
  # process so it survives the shell that started it and stops exactly when it
  # is told to: a logind inhibitor only exists while the process holding it lives.
  #
  # `idle` covers the screen blanking and locking the shell does; this covers the
  # sleep class on top of that — the desktop's own suspend policy and logind's
  # lid action — which nothing else here turns off. The lid switch has to be
  # named explicitly: a sleep inhibitor alone does not stop logind's
  # handle-lid-switch path.
  systemd.user.services.anixie-stayawake = {
    Unit.Description = "Hold off blanking, sleeping and suspending";
    Service = {
      Type = "simple";
      ExecStart = "${pkgs.systemd}/bin/systemd-inhibit --what=idle:sleep:handle-lid-switch --mode=block sleep infinity";
      # Nothing to restore on the way out; the inhibitor is the whole job.
      RemainAfterExit = false;
    };
  };
}
